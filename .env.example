# Copia este archivo a `.env` y ajusta los valores.
# NO subas `.env` al repositorio (ya está en .gitignore).

# SECRET_KEY de Django: OBLIGATORIA en producción (el arranque falla sin ella).
# Genera una clave NUEVA y segura (NO reutilices la de desarrollo):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# En desarrollo puedes dejar esta línea comentada: sin DJANGO_SECRET_KEY y con
# DJANGO_DEBUG=true, Django genera una clave aleatoria distinta en cada arranque.
# El valor de abajo es solo un placeholder de ejemplo; reemplázalo por el tuyo.
DJANGO_SECRET_KEY=4gq%qsbe$_o#8^ny*h$e#f4&r077uklij7%4h62%vch@&+8d+&

# DEBUG: true solo en desarrollo.
DJANGO_DEBUG=true

# Hosts permitidos separados por comas (p.ej. localhost,127.0.0.1,api.ejemplo.com)
DJANGO_ALLOWED_HOSTS=*

# CORS: true permite todos los orígenes (solo desarrollo).
DJANGO_CORS_ALLOW_ALL=true