# Copia este archivo a `.env` y ajusta los valores.
# NO subas `.env` al repositorio (ya está en .gitignore).

# SECRET_KEY de Django. En desarrollo puedes dejar el valor por defecto;
# en producción genera una nueva (https://djecrety.ir/ o `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`).
DJANGO_SECRET_KEY=django-insecure-!xp3fvs)-n21d#rw6)@m^3@%2h%-z3i6(=0u=t2o*_id5al@&w

# DEBUG: true solo en desarrollo.
DJANGO_DEBUG=true

# Hosts permitidos separados por comas (p.ej. localhost,127.0.0.1,api.ejemplo.com)
DJANGO_ALLOWED_HOSTS=*

# CORS: true permite todos los orígenes (solo desarrollo).
DJANGO_CORS_ALLOW_ALL=true