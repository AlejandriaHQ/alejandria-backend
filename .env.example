# Copia este archivo a `.env` y ajusta los valores.
# NO subas `.env` al repositorio (ya está en .gitignore).

# SECRET_KEY de Django: OBLIGATORIA en producción (el arranque falla sin ella).
# Genera una clave NUEVA y segura (NO reutilices la de desarrollo):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# En desarrollo puedes dejar esta línea comentada: sin DJANGO_SECRET_KEY y con
# DJANGO_DEBUG=true, Django genera una clave aleatoria distinta en cada arranque.
# El valor de abajo es solo un placeholder de ejemplo; reemplázalo por el tuyo.
DJANGO_SECRET_KEY=4gq%qsbe$_o#8^ny*h$e#f4&r077uklij7%4h62%vch@&+8d+&

# DEBUG: true solo en desarrollo.
DJANGO_DEBUG=true

# Hosts permitidos separados por comas (p.ej. localhost,127.0.0.1,api.ejemplo.com)
# Sin esta variable se usa un default seguro de desarrollo:
# localhost,127.0.0.1,testserver ('testserver' lo exige el test client).
# En producción define SIEMPRE los dominios reales; NUNCA uses '*' (F05 pentest).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: true permite todos los orígenes (solo desarrollo).
DJANGO_CORS_ALLOW_ALL=true

# --- Seguridad de transporte (F07) ---
# HTTPS: activa SOLO si la app se sirve sobre HTTPS (proxy/balanceador o
# `runserver_ssl`). En desarrollo con HTTP normal déjalos en false; un
# redireccionamiento SSL activo sin HTTPS real provoca bucles de redirección.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
# HSTS: 0 en desarrollo. En producción, si entiendes HSTS y sirves por HTTPS,
# usa 31536000 (1 año) y valora activar INCLUDE_SUBDOMAINS y PRELOAD.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false